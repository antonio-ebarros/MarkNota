{
  "name": "marknota",
  "version": "1.1.0",
  "description": "MarkNota: bloco de notas minimalista estilo Windows 11 Notepad com Markdown WYSIWYG (inspirado no MarkText) e fundo transparente fosco.",
  "main": "dist-electron/main.cjs",
  "author": {
    "name": "Antonio E. Barros",
    "url": "https://github.com/antonio-ebarros"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:electron",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/preload.cjs",
    "start": "npm run build && electron .",
    "start:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && npm run build:electron && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.marknota.app",
    "productName": "MarkNota",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "LICENSE",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "mimeType": "text/markdown"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "mimeType": "text/markdown"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon-512.png",
      "category": "Utility;TextEditor;",
      "maintainer": "Antonio E. Barros <antonio-ebarros@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "MarkNota",
          "Comment": "Bloco de notas minimalista com Markdown WYSIWYG",
          "StartupWMClass": "marknota"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "copyright": "Copyright © 2026 Antonio E. Barros"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "license": "MIT",
  "homepage": "https://github.com/antonio-ebarros/MarkNota",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonio-ebarros/MarkNota.git"
  }
}
